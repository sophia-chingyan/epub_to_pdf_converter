# ── Google OAuth ────────────────────────────────────────────────────────────
# Create an OAuth 2.0 Client (type: Web application) in Google Cloud Console.
# Authorized redirect URI must be exactly:  {BASE_URL}/auth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Comma-separated list of Google emails allowed to sign in.
# For a single-user deployment this is just your own address.
ALLOWED_EMAILS=you@example.com

# Public URL of the deployment (no trailing slash). Used to build the OAuth
# redirect URI. Locally use http://localhost:8000
BASE_URL=https://your-app.zeabur.app

# Long random string used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-long-random-value

# ── Storage ─────────────────────────────────────────────────────────────────
# Where uploads, job scratch space, and the PDF library live. On Zeabur, mount
# a persistent volume here so your library survives restarts.
DATA_DIR=/data

# ── Conversion (optional; sensible defaults shown) ───────────────────────────
# System Chromium binary used by Vivliostyle.
CHROMIUM_PATH=/usr/bin/chromium
# Page size for REFLOWABLE books (A5, A4, B5, JIS-B5, letter, ... or 105mm,148mm).
REFLOWABLE_PAGE_SIZE=A5
# Per-job render timeout in seconds (also used as the base for adaptive chunk timeouts).
JOB_TIMEOUT_SEC=300
# Max upload size in MB.
MAX_UPLOAD_MB=100
# Cover thumbnail width in pixels.
COVER_THUMB_WIDTH=200
# Number of books shown on the convert page.
RECENT_COUNT=10

# ── Chunked rendering (large-book resilience) ────────────────────────────────
# Max spine items per rendering chunk. Books larger than this are split, each
# chunk rendered separately and the results merged. Set to 0 to disable.
CHUNK_SIZE=50
# How many times to retry a failed chunk before giving up.
CHUNK_MAX_RETRIES=2
# Adaptive per-chunk timeout = base + (items in chunk) * per_item (seconds).
ADAPTIVE_TIMEOUT_BASE=60
ADAPTIVE_TIMEOUT_PER_SPINE_ITEM=10

# ── OCR / Text Layer (PUA-obfuscated books) ──────────────────────────────────
# "auto" = detect PUA-obfuscated text and OCR only those books (recommended).
# "always" = always run OCR on every converted PDF.
# "off" = never run OCR.
TEXT_LAYER_MODE=auto
# Tesseract languages for OCR (joined with "+"). Add chi_tra_vert/jpn_vert
# if your books use vertical text and you have the vertical Tesseract models
# installed (not included in the default Dockerfile).
OCR_LANGS=chi_tra+chi_sim+jpn+kor+eng
# Fraction of extracted characters in PUA ranges to trigger OCR (0.0–1.0).
PUA_THRESHOLD=0.20
