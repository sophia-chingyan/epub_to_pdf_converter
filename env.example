# ── Google OAuth ────────────────────────────────────────────────────────────
# Create an OAuth 2.0 Client (type: Web application) in Google Cloud Console.
# Authorized redirect URI must be exactly:  {BASE_URL}/auth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Comma-separated list of Google emails allowed to sign in.
# For a single-user deployment this is just your own address.
ALLOWED_EMAILS=you@example.com

# Public URL of the deployment (no trailing slash). Used to build the OAuth
# redirect URI. Locally use http://localhost:8000
#
# On Railway you can leave this unset: the injected RAILWAY_PUBLIC_DOMAIN is
# used automatically (https://<service>.up.railway.app). Set it explicitly when
# you put the service behind a custom domain.
BASE_URL=https://your-app.up.railway.app

# Long random string used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-long-random-value

# ── Storage ─────────────────────────────────────────────────────────────────
# Where uploads, job scratch space, and the PDF library live. This MUST be a
# persistent volume in production — a container filesystem is wiped by every
# redeploy, taking the whole library with it. On Railway, attach a volume and
# mount it at /data (the image's default); if you mount it elsewhere, either
# set DATA_DIR to that path or clear DATA_DIR and the volume's mount point is
# used automatically.
DATA_DIR=/data

# ── Conversion (optional; sensible defaults shown) ───────────────────────────
# Browser binary used by Vivliostyle. The image sets this to a small wrapper
# (/usr/local/bin/chromium-container) that adds the container-safe Chromium
# flags; override it only for local development, e.g. on macOS:
#   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROMIUM_PATH=/usr/bin/chromium
# Page size for REFLOWABLE books (A5, A4, B5, JIS-B5, letter, ... or 105mm,148mm).
REFLOWABLE_PAGE_SIZE=A5
# Per-job render timeout in seconds (also used as the base for adaptive chunk timeouts).
JOB_TIMEOUT_SEC=300
# Max upload size in MB.
MAX_UPLOAD_MB=100
# Cover thumbnail width in pixels.
COVER_THUMB_WIDTH=200
# Number of books shown on the convert page.
RECENT_COUNT=10

# ── Chunked rendering (large-book resilience) ────────────────────────────────
# Max spine items per rendering chunk. Books larger than this are split, each
# chunk rendered separately and the results merged. Set to 0 to disable.
CHUNK_SIZE=50
# How many times to retry a failed chunk before giving up.
CHUNK_MAX_RETRIES=2
# Adaptive per-chunk timeout = base + (items in chunk) * per_item (seconds).
ADAPTIVE_TIMEOUT_BASE=60
ADAPTIVE_TIMEOUT_PER_SPINE_ITEM=10

# ── OCR / Text Layer (PUA-obfuscated books) ──────────────────────────────────
# "auto" = detect PUA-obfuscated text and OCR only those books (recommended).
# "always" = always run OCR on every converted PDF.
# "off" = never run OCR.
TEXT_LAYER_MODE=auto
# Tesseract languages for OCR (joined with "+"). The vertical models
# (chi_tra_vert, jpn_vert) are installed by the Dockerfile and added
# automatically for vertical-text books, so they need not be listed here.
OCR_LANGS=chi_tra+chi_sim+jpn+kor+eng
# Parallel OCR workers (ocrmypdf --jobs). Defaults to the CPU count capped at 4;
# lower to 1 if the instance is memory-constrained.
OCR_JOBS=4
# Fraction of extracted characters in PUA ranges to trigger OCR (0.0–1.0).
PUA_THRESHOLD=0.20

# ── PDF → ePUB ──────────────────────────────────────────────────────────────
# "auto" = OCR scanned PDFs (no text layer) and PUA-obfuscated text layers
# before extraction; "off" = convert the existing text layer as is (scanned
# pages are kept as images).
PDF_OCR_MODE=auto
# Detect ruled tables and emit them as <table> (horizontal-text PDFs). 0 = off.
PDF_TABLES=1
# Rasterise vector drawings (charts, diagrams) into PNG figures. 0 = off.
PDF_DRAWINGS=1
